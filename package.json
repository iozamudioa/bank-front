{
  "name": "bank",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node node_modules/@angular/cli/bin/ng.js serve --proxy-config proxy.conf.json",
    "build": "node node_modules/@angular/cli/bin/ng.js build",
    "watch": "ng build --watch --configuration development",
    "test": "node node_modules/@angular/cli/bin/ng.js test --watch=false",
    "api:generate": "node scripts/generate-api.mjs && prettier --write src/app/core/api/generated docs/FRONTEND_API_MAPPING.md",
    "api:fetch": "node scripts/fetch-api.mjs",
    "pwa:check": "node scripts/check-pwa.mjs",
    "format": "prettier --write src scripts docs README.md angular.json proxy.conf.json ngsw-config.json public/manifest.webmanifest",
    "format:check": "prettier --check src scripts docs README.md angular.json proxy.conf.json ngsw-config.json public/manifest.webmanifest",
    "theme:generate": "node scripts/build-theme.mjs",
    "prestart": "npm run theme:generate",
    "prebuild": "npm run theme:generate",
    "prewatch": "npm run theme:generate",
    "pretest": "npm run theme:generate",
    "theme:check": "npm run theme:generate && node scripts/check-theme.mjs",
    "icons:update": "node scripts/update-icons.mjs",
    "icons:check": "node scripts/check-icons.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.5",
    "decimal.js": "^10.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "node": "^24.15.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}